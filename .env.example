# Mind Power Vaultt — Environment Variables
# Copy this to .env and fill in real values
# NEVER commit .env to git

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ADMIN_PASSWORD=your_secure_admin_password
MASTER_ACCESS_CODE=MPV2025MAY
CHERRY_WA=919059181616

# Email address that receives student journal reports (the "send to mentor" option)
MENTOR_EMAIL=your_mentor_email_here

# Mentor WhatsApp number for the weekly PDF wa.me fallback (digits only, with country code).
# VITE_ prefix = bundled into the client — fine here, the number is already public on the site.
VITE_MENTOR_WHATSAPP=919059181616

# ── Web Push (daily reminders) ───────────────────────────────────────────────
# Generate the pair once with:  npx web-push generate-vapid-keys
# The PUBLIC key is meant to be in the client bundle; the PRIVATE key never is.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@mindpowervaultt.com

# Shared secret the GitHub Actions scheduler sends as a bearer token to
# /api/cron/push. Must match the CRON_SECRET repo secret in GitHub.
CRON_SECRET=a_long_random_string
